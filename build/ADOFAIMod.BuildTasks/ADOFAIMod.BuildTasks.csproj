<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>ADOFAIMod.BuildTasks</RootNamespace>
		<AssemblyName>ADOFAIMod.BuildTasks</AssemblyName>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<OutputPath>..\..\obj\ADOFAIMod.BuildTasks.Project\$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations"
		                  Version="2026.2.0"
		                  PrivateAssets="all"/>
		<PackageReference Include="Microsoft.Build.Framework" Version="18.6.3" PrivateAssets="all"/>
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.6.3" PrivateAssets="all"/>
	</ItemGroup>

</Project>
