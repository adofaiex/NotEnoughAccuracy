<Project>

	<PropertyGroup>
		<BuildTasksProjectPath>$(MSBuildThisFileDirectory)build\ADOFAIMod.BuildTasks\ADOFAIMod.BuildTasks.csproj</BuildTasksProjectPath>
		<BuildTasksOutputDirectory>$(MSBuildThisFileDirectory)obj\ADOFAIMod.BuildTasks\$(Configuration)\</BuildTasksOutputDirectory>
		<BuildTasksAssemblyPath>$(BuildTasksOutputDirectory)ADOFAIMod.BuildTasks.dll</BuildTasksAssemblyPath>
		<AdofaiExePath Condition="'$(AdofaiExePath)' == ''">$([System.Environment]::GetEnvironmentVariable('ADOFAI_EXE'))</AdofaiExePath>
		<GameExePath Condition="'$(GameExePath)' == ''">$(AdofaiExePath)</GameExePath>
		<GameDir Condition="'$(GameExePath)' != ''">$([System.IO.Path]::GetDirectoryName($(GameExePath)))</GameDir>
		<GameFileName Condition="'$(GameExePath)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension($(GameExePath)))</GameFileName>
		<IsWindows Condition="'$(IsWindows)' == ''">true</IsWindows>
		<PathSeparator Condition="'$(IsWindows)' == 'true'">\</PathSeparator>
		<PathSeparator Condition="'$(IsUnix)' == 'true'">/</PathSeparator>
		<ManagedAssembliesDir Condition="'$(GameExePath)' != ''">$(GameDir)$(PathSeparator)$(GameFileName)_Data$(PathSeparator)Managed</ManagedAssembliesDir>
	</PropertyGroup>

	<UsingTask TaskName="ADOFAIMod.BuildTasks.ResolveAdofaiExecutable"
	           AssemblyFile="$(BuildTasksAssemblyPath)"/>

	<Target Name="BuildAdofaiBuildTasks"
	        Condition="!Exists('$(BuildTasksAssemblyPath)')">
		<MSBuild Projects="$(BuildTasksProjectPath)"
		         Targets="Build"
		         Properties="Configuration=$(Configuration);OutputPath=$(BuildTasksOutputDirectory);AppendTargetFrameworkToOutputPath=false"/>
	</Target>

	<Target Name="ResolveAdofaiExePath"
	        BeforeTargets="ResolveAssemblyReferences;Build"
	        DependsOnTargets="BuildAdofaiBuildTasks">
		<ResolveAdofaiExecutable>
			<Output TaskParameter="ExecutablePath" PropertyName="AdofaiExePath"/>
		</ResolveAdofaiExecutable>

		<PropertyGroup>
			<GameExePath>$(AdofaiExePath)</GameExePath>
			<GameDir>$([System.IO.Path]::GetDirectoryName($(GameExePath)))</GameDir>
			<GameFileName>$([System.IO.Path]::GetFileNameWithoutExtension($(GameExePath)))</GameFileName>
			<IsWindows Condition="'$(IsWindows)' == ''">true</IsWindows>
			<PathSeparator Condition="'$(IsWindows)' == 'true'">\</PathSeparator>
			<PathSeparator Condition="'$(IsUnix)' == 'true'">/</PathSeparator>
			<ManagedAssembliesDir>$(GameDir)$(PathSeparator)$(GameFileName)_Data$(PathSeparator)Managed</ManagedAssembliesDir>
		</PropertyGroup>

		<ItemGroup Condition="'$(GameExePath)' != '' AND Exists('$(GameExePath)')">
			<ManagedAssemblyFiles Include="$(ManagedAssembliesDir)\**\*.dll"
			                      Exclude="$(ManagedAssembliesDir)\System.*;$(ManagedAssembliesDir)\Microsoft.*"/>
			<Reference Include="@(ManagedAssemblyFiles)">
				<HintPath>%(ManagedAssemblyFiles.FullPath)</HintPath>
			</Reference>
		</ItemGroup>

		<Message Text="Resolved ADOFAI executable: $(GameExePath)"
		         Importance="high"
		         Condition="'$(GameExePath)' != ''"/>
		<Message Text="Managed assembly references discovered: @(ManagedAssemblyFiles-&gt;Count())"
		         Importance="high"/>
		<Error Text="Could not find the A Dance of Fire and Ice executable. Set ADOFAI_EXE or check the Steam registry and libraryfolders.vdf."
		       Condition="'$(GameExePath)' == ''"/>
		<Error Text="Game executable does not exist: $(GameExePath). Please check ADOFAI_EXE."
		       Condition="'$(GameExePath)' != '' AND !Exists('$(GameExePath)')"/>
	</Target>

	<Target Name="ValidateGameExePath"
	        BeforeTargets="Build"
	        DependsOnTargets="ResolveAdofaiExePath">
		<Error Text="Game executable does not exist: $(GameExePath). Please check if the path is correct."
		       Condition="'$(GameExePath)' != '' AND !Exists('$(GameExePath)')"/>
	</Target>

	<Target Name="CopyToOut" AfterTargets="Build">
		<PropertyGroup>
			<OutDir>$(ProjectDir)out\</OutDir>
		</PropertyGroup>

		<MakeDir Directories="$(OutDir)"/>
		<RemoveDir Directories="$(OutDir)Resources"
		           Condition="Exists('$(OutDir)Resources')"/>
		<ItemGroup>
			<FilesToCopy Include="$(OutputPath)$(AssemblyName).dll"/>
			<ResourceFiles Include="$(ProjectDir)Resources\**\*"
			               Exclude="$(ProjectDir)Resources\**\*\"/>
		</ItemGroup>

		<Copy SourceFiles="@(FilesToCopy)"
		      DestinationFolder="$(OutDir)"
		      SkipUnchangedFiles="true"/>
		<Copy SourceFiles="@(ResourceFiles)"
		      DestinationFolder="$(OutDir)%(RecursiveDir)"
		      SkipUnchangedFiles="true"/>
		<Message Text="Files copied to out folder: $(OutDir)" Importance="high"/>
	</Target>

	<Target Name="DeployAndLaunch"
	        AfterTargets="CopyToOut"
	        Condition="'$(GameExePath)' != '' AND Exists('$(GameExePath)')">
		<PropertyGroup>
			<ModsDir>$(GameDir)$(PathSeparator)Mods$(PathSeparator)$(AssemblyName)$(PathSeparator)</ModsDir>
		</PropertyGroup>

		<Message Text="Game Directory: $(GameDir)" Importance="high"/>
		<Message Text="Managed Assemblies Path: $(ManagedAssembliesDir)" Importance="high"/>
		<Message Text="Platform: $(OS)" Importance="high"/>

		<MakeDir Directories="$(ModsDir)"/>
		<RemoveDir Directories="$(ModsDir)Resources"
		           Condition="Exists('$(ModsDir)Resources')"/>
		<ItemGroup>
			<ModFiles Include="$(ProjectDir)out\**\*"
			          Exclude="$(ProjectDir)out\**\*\"/>
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)"
		      DestinationFolder="$(ModsDir)%(RecursiveDir)"
		      SkipUnchangedFiles="true"/>
		<Message Text="Mod deployed to game directory: $(ModsDir)" Importance="high"/>

		<Exec Command="start &quot;&quot; &quot;$(GameExePath)&quot;"
		      IgnoreExitCode="true"
		      Condition="'$(AutoLaunchGame)' == 'true' AND '$(IsWindows)' == 'true'"/>
		<Exec Command="chmod +x &quot;$(GameExePath)&quot; &amp;&amp; nohup &quot;$(GameExePath)&quot; &gt; /dev/null 2&gt;&amp;1 &amp;"
		      IgnoreExitCode="true"
		      Condition="'$(AutoLaunchGame)' == 'true' AND '$(IsUnix)' == 'true'"/>

		<Message Text="Game launched: $(GameExePath)"
		         Importance="high"
		         Condition="'$(AutoLaunchGame)' == 'true'"/>
		<Message Text="Auto-launch disabled. Game not started."
		         Importance="high"
		         Condition="'$(AutoLaunchGame)' != 'true'"/>
	</Target>

</Project>
